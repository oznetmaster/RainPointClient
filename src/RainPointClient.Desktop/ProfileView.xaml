<UserControl x:Class="RainPointClient.Desktop.ProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6F3" Foreground="#23382F" FontFamily="Segoe UI" FontSize="14">
 <StackPanel Margin="12">
  <TextBlock Text="Zone profile and recommendations" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Describe the planting area for cloud suggestions. Saving a profile does not create or enable watering plans." TextWrapping="Wrap" Margin="0,8"/>
  <WrapPanel Margin="0,8"><Label Content="Zone"/><ComboBox x:Name="ProfileZone" ItemsSource="{Binding PlanZones}" SelectedItem="{Binding ProfileZone}" IsEnabled="{Binding CanEdit}" Width="80" Margin="8,0"/><Button x:Name="LoadProfile" Content="Load / reset profile" Click="Load_Click" IsEnabled="{Binding CanLoadProfile}"/></WrapPanel>
  <CheckBox x:Name="RecommendationsEnabled" Content="Show smart plan recommendations" IsChecked="{Binding RecommendationsEnabled}" IsEnabled="{Binding CanSaveProfile}" Margin="0,12"/>
  <ItemsControl x:Name="ProfileCategories" ItemsSource="{Binding ProfileCategories}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Name}"/><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" MinWidth="300" HorizontalAlignment="Left"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Button x:Name="SaveProfile" Content="Save zone profile" Click="Save_Click" IsEnabled="{Binding CanSaveProfile}" HorizontalAlignment="Left" Margin="0,12"/>
  <TextBlock x:Name="ProfileMessage" Text="{Binding ProfileMessage}" TextWrapping="Wrap" Margin="0,8"/>
  <GroupBox Header="Cloud recommendation"><StackPanel Margin="10">
   <Button x:Name="LoadRecommendations" Content="Get recommendation" Click="Recommendation_Click" IsEnabled="{Binding CanLoadProfile}" HorizontalAlignment="Left"/>
   <TextBlock x:Name="RecommendationText" Text="{Binding RecommendationText}" TextWrapping="Wrap" Margin="0,12"/>
   <Button x:Name="PrepareRecommendedPlan" Content="Prepare disabled plan draft" Click="Prepare_Click" IsEnabled="{Binding CanPrepareRecommendedPlan}" HorizontalAlignment="Left"/>
   <TextBlock Text="Review the draft in Plans. Start time and effective date use the home's local calendar. Nothing is saved automatically." TextWrapping="Wrap" Margin="0,8"/>
  </StackPanel></GroupBox>
 </StackPanel>
</UserControl>