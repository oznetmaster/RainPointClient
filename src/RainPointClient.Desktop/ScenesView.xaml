<UserControl x:Class="RainPointClient.Desktop.ScenesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F6F8F5">
 <StackPanel Margin="12">
  <TextBlock Text="Smart Scenes" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Scenes run automatically. Saving or enabling one can cause later watering, rain delays or messages. Disabling a scene does not stop a valve already running." TextWrapping="Wrap" Margin="0,8"/>
  <WrapPanel><Button x:Name="LoadScenes" Content="Load scenes" Click="Load_Click" IsEnabled="{Binding CanReadScenes}"/><ComboBox x:Name="ScenePicker" ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}" DisplayMemberPath="Name" Width="220"/><Button x:Name="LoadScene" Content="Read details" Click="Detail_Click" IsEnabled="{Binding CanLoadScene}"/><Button Content="Edit selected scene" Click="Edit_Click" IsEnabled="{Binding CanWriteScene}"/><Button x:Name="NewScene" Content="New draft" Click="New_Click" IsEnabled="{Binding CanReadScenes}"/></WrapPanel>
  <WrapPanel><Button Content="Enable selected scene" Click="Enable_Click" IsEnabled="{Binding CanWriteScene}"/><Button Content="Disable selected scene" Click="Disable_Click" IsEnabled="{Binding CanWriteScene}"/><Button Content="Delete selected scene" Click="Delete_Click" IsEnabled="{Binding CanWriteScene}"/></WrapPanel>
  <TextBlock x:Name="SceneStatus" Text="{Binding SceneMessage}" TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock Text="Conditions" FontWeight="SemiBold"/><ListBox x:Name="Conditions" ItemsSource="{Binding SceneConditions}" SelectedItem="{Binding SelectedSceneCondition}" DisplayMemberPath="Description" MinHeight="50"/><Button Content="Remove selected condition from draft" Click="RemoveCondition_Click"/>
  <TextBlock Text="Actions" FontWeight="SemiBold"/><ListBox x:Name="Actions" ItemsSource="{Binding SceneActions}" SelectedItem="{Binding SelectedSceneAction}" DisplayMemberPath="Description" MinHeight="50"/><Button Content="Remove selected action from draft" Click="RemoveAction_Click"/>
  <GroupBox Header="Execution history"><StackPanel Margin="8">
   <TextBlock Text="History uses the selected scene, or all scenes when none is selected. Dates use UTC." TextWrapping="Wrap"/>
   <WrapPanel><Label Content="From (yyyy-MM-dd)"/><TextBox Text="{Binding SceneHistoryFromUtc, UpdateSourceTrigger=PropertyChanged}" Width="100"/><Label Content="Through"/><TextBox Text="{Binding SceneHistoryThroughUtc, UpdateSourceTrigger=PropertyChanged}" Width="100"/><Button x:Name="LoadSceneHistory" Content="Load history" Click="History_Click" IsEnabled="{Binding CanReadSceneHistory}"/><Button x:Name="NextSceneHistory" Content="Next page" Click="NextHistory_Click" IsEnabled="{Binding CanReadNextSceneHistory}"/></WrapPanel>
   <TextBlock Text="{Binding SceneHistoryMessage}" TextWrapping="Wrap"/>
   <DataGrid x:Name="SceneHistoryGrid" ItemsSource="{Binding SceneHistory}" SelectedItem="{Binding SelectedSceneLog}" AutoGenerateColumns="False" IsReadOnly="True" Height="140"><DataGrid.Columns>
    <DataGridTextColumn Header="Triggered (UTC)" MinWidth="190" Binding="{Binding TriggeredAt, StringFormat=u}"/><DataGridTextColumn Header="Scene" MinWidth="90" Binding="{Binding SceneId}"/>
   </DataGrid.Columns></DataGrid>
   <TextBlock Text="{Binding SceneHistoryActionMessage}" TextWrapping="Wrap"/>
   <DataGrid x:Name="SceneHistoryActions" ItemsSource="{Binding SceneHistoryActions}" AutoGenerateColumns="False" IsReadOnly="True" Height="100"><DataGrid.Columns>
    <DataGridTextColumn Header="Action" MinWidth="90" Binding="{Binding ActionId}"/><DataGridTextColumn Header="Hub" MinWidth="120" Binding="{Binding HubId}"/><DataGridTextColumn Header="Address" MinWidth="90" Binding="{Binding DeviceAddress, TargetNullValue=—}"/><DataGridTextColumn Header="Reported outcome" MinWidth="180" Binding="{Binding Outcome}" Width="*"/><DataGridTextColumn Header="Result code" MinWidth="110" Binding="{Binding ResultCode}"/>
   </DataGrid.Columns></DataGrid>
  </StackPanel></GroupBox>
  <GroupBox Header="Scene draft"><StackPanel Margin="8" IsEnabled="{Binding CanEditSceneDraft}">
   <TextBlock Text="Select New draft or Edit selected scene. Scenes with unsupported conditions, actions or effective periods cannot be edited here without losing settings." TextWrapping="Wrap"/>
   <WrapPanel><Label Content="Name"/><TextBox Text="{Binding SceneNameDraft, UpdateSourceTrigger=PropertyChanged}" Width="220"/><CheckBox Content="Require all conditions" IsChecked="{Binding SceneMatchAll}" Margin="12,4"/></WrapPanel>
   <WrapPanel><Label Content="Maximum runs/day (0 = unlimited)"/><TextBox Text="{Binding SceneMaximumRuns, UpdateSourceTrigger=PropertyChanged}" Width="50"/><Label Content="Minimum interval (minutes)"/><TextBox Text="{Binding SceneIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="60"/></WrapPanel>
   <WrapPanel><Label Content="Start date (optional yyyy-MM-dd)"/><TextBox Text="{Binding SceneStartDate, UpdateSourceTrigger=PropertyChanged}" Width="100"/><Label Content="End date"/><TextBox Text="{Binding SceneEndDate, UpdateSourceTrigger=PropertyChanged}" Width="100"/></WrapPanel>
   <WrapPanel><Label Content="Effective date recurrence"/><ComboBox ItemsSource="{Binding SceneRepeats}" SelectedItem="{Binding SceneEffectiveRepeat}" Width="130"/></WrapPanel><ItemsControl ItemsSource="{Binding SceneEffectiveWeekdays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <WrapPanel><Label Content="Solar window (None uses the clock fields)"/><ComboBox x:Name="SolarPeriod" ItemsSource="{Binding SceneSolarPeriods}" SelectedItem="{Binding SceneSolarPeriod}" Width="130"/></WrapPanel>
   <WrapPanel><Label Content="Daily window (optional HH:mm)"/><TextBox Text="{Binding SceneWindowStart, UpdateSourceTrigger=PropertyChanged}" Width="70"/><Label Content="to"/><TextBox Text="{Binding SceneWindowEnd, UpdateSourceTrigger=PropertyChanged}" Width="70"/><TextBlock Text="  Leave blank with time conditions." VerticalAlignment="Center"/></WrapPanel>
   <WrapPanel><ComboBox ItemsSource="{Binding SceneMetrics}" SelectedItem="{Binding SceneMetric}" Width="190"/><ComboBox ItemsSource="{Binding SceneComparisons}" SelectedItem="{Binding SceneComparison}" Width="110"/><TextBox Text="{Binding SceneThreshold, UpdateSourceTrigger=PropertyChanged}" Width="60"/><Button x:Name="AddWeatherCondition" Content="Add weather condition" Click="Weather_Click"/></WrapPanel>
   <WrapPanel><Button Content="Load weather types" Click="WeatherTypes_Click"/><ComboBox ItemsSource="{Binding SceneWeatherTypes}" SelectedItem="{Binding SelectedSceneWeatherType}" DisplayMemberPath="Name" Width="200"/><Button Content="Add weather-type condition" Click="WeatherType_Click"/></WrapPanel>
   <WrapPanel><ComboBox x:Name="TimeRecurrence" ItemsSource="{Binding SceneRepeats}" SelectedItem="{Binding SceneRepeat}" Width="110"/><ComboBox x:Name="TimeKind" ItemsSource="{Binding SceneTimes}" SelectedItem="{Binding SceneTime}" Width="100"/><TextBox Text="{Binding SceneClockTime, UpdateSourceTrigger=PropertyChanged}" Width="65"/><Button x:Name="AddTimeCondition" Content="Add time condition" Click="Time_Click"/></WrapPanel>
   <ItemsControl x:Name="TimeWeekdays" ItemsSource="{Binding SceneWeekdays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <WrapPanel><Label Content="Once, home time (yyyy-MM-dd HH:mm)"/><TextBox x:Name="OnceTime" Text="{Binding SceneOnceDateTime, UpdateSourceTrigger=PropertyChanged}" Width="150"/><Button x:Name="AddOnceCondition" Content="Add one-time condition" Click="Once_Click"/></WrapPanel>
   <WrapPanel><Label Content="Notification email"/><TextBox Text="{Binding SceneNotificationEmail, UpdateSourceTrigger=PropertyChanged}" Width="180"/><Label Content="Message"/><TextBox Text="{Binding SceneNotificationText, UpdateSourceTrigger=PropertyChanged}" Width="180"/><Button Content="Add notification" Click="Notify_Click"/></WrapPanel>
   <WrapPanel><Label Content="Rain delay days"/><TextBox Text="{Binding SceneRainDelayDays, UpdateSourceTrigger=PropertyChanged}" Width="50"/><Label Content="Zone"/><ComboBox ItemsSource="{Binding ControlZones}" SelectedItem="{Binding ControlZone}" Width="60"/><Button Content="Add delay for selected timer zone" Click="Delay_Click"/></WrapPanel>
   <Button x:Name="SaveScene" Content="Save and allow scene to run" Click="Save_Click" IsEnabled="{Binding CanCreateScene}"/>
  </StackPanel></GroupBox>
 </StackPanel>
</UserControl>