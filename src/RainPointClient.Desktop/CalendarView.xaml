<UserControl x:Class="RainPointClient.Desktop.CalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6F3" Foreground="#23382F" FontFamily="Segoe UI" FontSize="14">
 <StackPanel Margin="12">
  <TextBlock Text="Plan calendar" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Select a date in the home's local calendar. The initial date comes from this PC; change it if the home's date differs. Previewing never sends a watering command." TextWrapping="Wrap" Margin="0,8"/>
  <WrapPanel><Label Content="Zone" Target="{Binding ElementName=CalendarZonePicker}"/><ComboBox x:Name="CalendarZonePicker" ItemsSource="{Binding PlanZones}" SelectedItem="{Binding CalendarZone}" IsEnabled="{Binding CanEdit}" MinWidth="70"/><Button x:Name="LoadCalendar" Content="Load / refresh calendar" Click="Load_Click" IsEnabled="{Binding CanLoadCalendar}"/></WrapPanel>
  <TextBlock Text="{Binding CalendarReadAt}" Margin="0,8"/>
  <Calendar x:Name="PlanCalendar" SelectedDatesChanged="Selection_Changed" SelectedDate="{Binding CalendarDate}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left"/>
  <TextBlock x:Name="CalendarNext" Text="{Binding CalendarNext}" TextWrapping="Wrap" Margin="0,10" FontWeight="SemiBold"/>
  <DataGrid x:Name="CalendarRows" ItemsSource="{Binding CalendarRows}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" Height="210" HeadersVisibility="Column" RowHeaderWidth="0">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="65" MinWidth="65"/>
    <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="80" MinWidth="80"/>
    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="*" MinWidth="140"/>
    <DataGridTextColumn Header="Seasonal" Binding="{Binding Seasonal}" Width="90" MinWidth="90"/>
    <DataGridTextColumn Header="Calendar duration" Binding="{Binding Duration}" Width="160" MinWidth="160"/>
    <DataGridTextColumn Header="Rain delay" Binding="{Binding RainDelay}" Width="*" MinWidth="180"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="CalendarMessage" Text="{Binding CalendarMessage}" TextWrapping="Wrap" Margin="0,12"/>
 </StackPanel>
</UserControl>