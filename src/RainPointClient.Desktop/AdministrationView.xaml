<UserControl x:Class="RainPointClient.Desktop.AdministrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel Background="#F6F8F5">
<StackPanel.Resources><Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,12,6"/></Style></StackPanel.Resources>
<TextBlock Text="Home and account" FontSize="22" Margin="0,8"/>
<WrapPanel><Button Content="Reload homes" Click="ReloadHomes_Click" IsEnabled="{Binding CanReadAccount}"/><Button x:Name="LoadHome" Content="Load selected home" Click="LoadHome_Click" IsEnabled="{Binding CanReadAdministration}"/></WrapPanel>
<GroupBox Header="Home settings"><StackPanel IsEnabled="{Binding CanWriteAdministration}">
<WrapPanel><Label Content="Name"/><TextBox Text="{Binding HomeNameDraft, UpdateSourceTrigger=PropertyChanged}" Width="220"/><Button Content="Rename home" Click="RenameHome_Click"/></WrapPanel>
<WrapPanel><Label Content="Latitude"/><TextBox Text="{Binding LatitudeDraft, UpdateSourceTrigger=PropertyChanged}" Width="110"/><Label Content="Longitude"/><TextBox Text="{Binding LongitudeDraft, UpdateSourceTrigger=PropertyChanged}" Width="110"/><Button Content="Save location" Click="Location_Click"/></WrapPanel>
<StackPanel IsEnabled="{Binding CanWriteUnits}"><WrapPanel><CheckBox Content="12-hour clock" IsChecked="{Binding TwelveHourClock}"/><CheckBox Content="Fahrenheit" IsChecked="{Binding Fahrenheit}"/><CheckBox Content="Imperial length" IsChecked="{Binding ImperialLength}"/><CheckBox Content="Imperial volume" IsChecked="{Binding ImperialVolume}"/></WrapPanel>
<WrapPanel><Label Content="Pressure"/><ComboBox ItemsSource="{Binding PressureUnits}" SelectedItem="{Binding PressureUnit}" Width="190"/><Button Content="Save display units" Click="Units_Click"/></WrapPanel></StackPanel>
<TextBlock Text="Display preferences do not change the units returned by the client." TextWrapping="Wrap"/>
</StackPanel></GroupBox>
<GroupBox Header="Rooms"><StackPanel IsEnabled="{Binding CanWriteAdministration}"><ComboBox x:Name="RoomPicker" ItemsSource="{Binding Rooms}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedRoom}"/>
<WrapPanel><Label Content="Room name"/><TextBox Text="{Binding RoomNameDraft, UpdateSourceTrigger=PropertyChanged}" Width="190"/><Button Content="Add room" Click="AddRoom_Click"/><Button Content="Rename selected" Click="RenameRoom_Click"/><Button Content="Delete selected" Click="DeleteRoom_Click"/></WrapPanel>
<Button Content="Load room assignments" Click="RoomAssignments_Click"/>
<ItemsControl ItemsSource="{Binding RoomDeviceChoices}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="Save room assignments" Click="SaveAssignments_Click" IsEnabled="{Binding CanSaveRoomAssignments}"/>
</StackPanel></GroupBox>
<GroupBox Header="Selected hub or timer name"><WrapPanel IsEnabled="{Binding CanWriteAdministration}"><TextBox Text="{Binding DeviceNameDraft, UpdateSourceTrigger=PropertyChanged}" Width="230"/><Button Content="Rename selected hub" Click="HubName_Click"/><Button Content="Rename selected timer" Click="TimerName_Click"/></WrapPanel></GroupBox>
<GroupBox Header="Members"><StackPanel IsEnabled="{Binding CanWriteAdministration}"><ComboBox ItemsSource="{Binding Members}" DisplayMemberPath="Email" SelectedItem="{Binding SelectedMember}"/>
<WrapPanel><ComboBox ItemsSource="{Binding MemberRoles}" SelectedItem="{Binding MemberRoleDraft}" Width="160"/><Button Content="Change role" Click="Role_Click"/><Button Content="Remove member" Click="RemoveMember_Click"/><Button Content="Transfer ownership" Click="Transfer_Click"/></WrapPanel>
<WrapPanel><Label Content="Registered email"/><TextBox Text="{Binding InviteEmail, UpdateSourceTrigger=PropertyChanged}" Width="240"/><Button Content="Send invitation" Click="Invite_Click"/></WrapPanel></StackPanel></GroupBox>
<GroupBox Header="Invitations to this account"><StackPanel IsEnabled="{Binding CanReadAccount}"><Button Content="Load invitations" Click="Invitations_Click"/><ComboBox ItemsSource="{Binding Invitations}" DisplayMemberPath="HomeName" SelectedItem="{Binding SelectedInvitation}"/><WrapPanel><Button Content="Accept selected" Click="Accept_Click"/><Button Content="Decline selected" Click="Decline_Click"/></WrapPanel></StackPanel></GroupBox>
<GroupBox Header="Account notifications"><StackPanel><Button Content="Load sign-in observation" Click="Notifications_Click" IsEnabled="{Binding CanReadAccount}"/>
<WrapPanel IsEnabled="{Binding CanWriteNotifications}"><CheckBox Content="Mobile alerts" IsChecked="{Binding MobileNotifications}"/><CheckBox Content="Email alerts" IsChecked="{Binding EmailNotifications}"/><Button x:Name="SaveNotifications" Content="Save notifications" Click="SaveNotifications_Click"/></WrapPanel><TextBlock Text="{Binding NotificationMessage}" TextWrapping="Wrap"/></StackPanel></GroupBox>
<GroupBox Header="Home membership"><StackPanel><WrapPanel IsEnabled="{Binding CanReadAccount}"><Label Content="New home"/><TextBox Text="{Binding NewHomeName, UpdateSourceTrigger=PropertyChanged}" Width="170"/><Label Content="IANA time zone"/><TextBox Text="{Binding NewHomeTimeZone, UpdateSourceTrigger=PropertyChanged}" Width="170"/><Button Content="Create home" Click="CreateHome_Click"/></WrapPanel><WrapPanel IsEnabled="{Binding CanWriteAdministration}"><Button Content="Leave selected home" Click="LeaveHome_Click"/><Button Content="Delete selected home" Click="DeleteHome_Click"/></WrapPanel></StackPanel></GroupBox>
<WrapPanel><Label Content="Current time zone"/><TextBlock Text="{Binding CurrentTimeZone}" VerticalAlignment="Center"/><Button Content="Load time zones" Click="TimeZones_Click" IsEnabled="{Binding CanReadAdministration}"/><ComboBox ItemsSource="{Binding TimeZones}" SelectedItem="{Binding SelectedTimeZone}" DisplayMemberPath="Name" Width="190"/><Button Content="Change time zone" Click="TimeZone_Click" IsEnabled="{Binding CanWriteAdministration}"/></WrapPanel>
<WrapPanel><Label Content="Date format (saved with units)"/><ComboBox ItemsSource="{Binding DateFormats}" SelectedItem="{Binding DateFormat}" Width="230" IsEnabled="{Binding CanWriteUnits}"/><Button Content="Load currencies" Click="Currencies_Click" IsEnabled="{Binding CanReadAdministration}"/><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" DisplayMemberPath="Name" Width="150"/><Button Content="Save currency" Click="Currency_Click" IsEnabled="{Binding CanWriteAdministration}"/></WrapPanel>
<TextBlock Text="{Binding AdministrationMessage}" TextWrapping="Wrap" Margin="0,10"/>
</StackPanel></UserControl>