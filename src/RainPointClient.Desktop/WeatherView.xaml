<UserControl x:Class="RainPointClient.Desktop.WeatherView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel Background="#F6F8F5"><TextBlock Text="Weather" FontSize="22" Margin="0,8"/><Button x:Name="LoadWeather" Content="Load weather" Click="Load_Click" IsEnabled="{Binding CanReadWeather}" HorizontalAlignment="Left"/>
<GroupBox Header="Current conditions"><StackPanel DataContext="{Binding CurrentWeather}"><TextBlock Text="{Binding TemperatureCelsius, StringFormat=Temperature: {0:0.0} °C, TargetNullValue=Temperature unknown}"/><TextBlock Text="{Binding HumidityPercent, StringFormat=Humidity: {0:0} %, TargetNullValue=Humidity unknown}"/><TextBlock Text="{Binding WindSpeedKilometresPerHour, StringFormat=Wind: {0:0.0} km/h, TargetNullValue=Wind unknown}"/><TextBlock Text="{Binding ExpiresAt, StringFormat=Valid until: {0:u}, TargetNullValue=Expiry unknown}"/></StackPanel></GroupBox>
<GroupBox Header="Hourly forecast"><DataGrid x:Name="HourlyForecast" ItemsSource="{Binding HourlyWeather}" AutoGenerateColumns="False" IsReadOnly="True" Height="260"><DataGrid.Columns>
<DataGridTextColumn Header="Local time" Binding="{Binding ForecastLocalTime, StringFormat=yyyy-MM-dd HH:mm}"/><DataGridTextColumn Header="°C" Binding="{Binding TemperatureCelsius, StringFormat=0.0}"/><DataGridTextColumn Header="Rain %" Binding="{Binding RainProbabilityPercent}"/><DataGridTextColumn Header="Humidity %" Binding="{Binding HumidityPercent}"/><DataGridTextColumn Header="Wind km/h" Binding="{Binding WindSpeedKilometresPerHour}"/>
</DataGrid.Columns></DataGrid></GroupBox>
<GroupBox Header="Daily forecast"><DataGrid x:Name="DailyForecast" ItemsSource="{Binding DailyWeather}" AutoGenerateColumns="False" IsReadOnly="True" Height="260"><DataGrid.Columns>
<DataGridTextColumn Header="Local date" Binding="{Binding ForecastDate, StringFormat=yyyy-MM-dd}"/><DataGridTextColumn Header="Min °C" Binding="{Binding MinimumCelsius, StringFormat=0.0}"/><DataGridTextColumn Header="Max °C" Binding="{Binding MaximumCelsius, StringFormat=0.0}"/><DataGridTextColumn Header="Rain %" Binding="{Binding RainProbabilityPercent}"/><DataGridTextColumn Header="Wind km/h" Binding="{Binding WindSpeedKilometresPerHour}"/><DataGridTextColumn Header="Sunrise" Binding="{Binding Sunrise}"/><DataGridTextColumn Header="Sunset" Binding="{Binding Sunset}"/>
</DataGrid.Columns></DataGrid></GroupBox><TextBlock Text="{Binding WeatherMessage}" TextWrapping="Wrap" Margin="0,10"/></StackPanel></UserControl>