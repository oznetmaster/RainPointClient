<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <PackageId>RainPointClient</PackageId>
    <Title>RainPointClient</Title>
    <PackageTags>RainPoint;HomGar;irrigation;smart-garden;MQTT</PackageTags>
    <RepositoryUrl>https://github.com/oznetmaster/RainPointClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/oznetmaster/RainPointClient</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/oznetmaster/RainPointClient/blob/v1.2.1/release-notes/v1.2.1.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Authors>Neil Colvin</Authors>
    <Copyright>Copyright © 2026 Neil Colvin</Copyright>
    <Description>A typed RainPoint Home / Smart+ cloud client.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <EmbeddedResource Include="Protocol/AliyunIoTRoot.pem" />
    <InternalsVisibleTo Include="RainPointClient.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../licenses/**" Pack="true" PackagePath="licenses/" />
    <None Include="../../ATTRIBUTIONS.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../release-notes/v$(Version).md" Pack="true" PackagePath="/release-notes/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- XML documentation is part of the supported source/API contract in both configurations. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1711;CS1712</WarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Debug'">true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors Condition="'$(Configuration)' == 'Debug'">true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>
  <Import Project="../../tools/Documentation.targets" />
</Project>