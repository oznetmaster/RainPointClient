{
  "schema": 1,
  "tasks": {
    "unit-tests-test-run-offline-nunit-tests": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "test",
            "${env:TEST_PROJECT}",
            "-c",
            "Release",
            "-f",
            "${env:TEST_FRAMEWORK}",
            "--filter",
            "TestCategory!=Live",
            "--logger",
            "trx;LogFileName=tests.trx",
            "--results-directory",
            "artifacts/test-results",
            "-p:ContinuousIntegrationBuild=true"
          ]
        }
      ],
      "results": [
        "artifacts/test-results/**/*.trx"
      ]
    },
    "unit-tests-release-policy-validate-release-metadata-and-check-policy": {
      "commands": [
        {
          "executable": "pwsh",
          "script": "build/steps/unit-tests-release-policy-validate-release-metadata-and-check-policy.ps1",
          "shell": "pwsh"
        }
      ]
    },
    "documentation": {
      "commands": [
        {
          "executable": "pwsh",
          "script": "build/steps/documentation-0.ps1",
          "shell": "pwsh"
        }
      ],
      "documentation": {
        "config": "docfx/docfx.json",
        "site": "artifacts/docs-site",
        "title": "RainPointClient"
      }
    },
    "xml-documentation": {
      "commands": [
        {
          "executable": "dotnet",
          "arguments": [
            "--version"
          ]
        }
      ]
    },
    "release-assets": {
      "commands": [
        {
          "executable": "pwsh",
          "arguments": [
            "-NoProfile",
            "-File",
            "tools/Test-ReleasePreparation.ps1"
          ]
        },
        {
          "executable": "pwsh",
          "arguments": [
            "-NoProfile",
            "-File",
            "tools/Build-Documentation.ps1"
          ]
        },
        {
          "arguments": [
            "-NoProfile",
            "-File",
            "${env:BUILD_AUTOMATION_COMPONENT_ROOT}/ReleasePublishing/Stage-Release.ps1",
            "-Root",
            ".",
            "-Version",
            "${env:RELEASE_VERSION}"
          ],
          "executable": "pwsh"
        },
        {
          "arguments": [
            "-NoProfile",
            "-File",
            "tools/Test-ReleasePackage.ps1",
            "-Package",
            "artifacts/release/RainPointClient.${env:RELEASE_VERSION}.nupkg",
            "-Version",
            "${env:RELEASE_VERSION}"
          ],
          "executable": "pwsh"
        }
      ]
    }
  },
  "xmlDocumentation": {
    "projects": [
      "src/RainPointClient/RainPointClient.csproj"
    ]
  }
}